<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign Up - LabelIQ</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: { extend: { fontFamily: { sans: ['Inter', 'sans-serif'] } } }
    }
  </script>
</head>
<body class="bg-[#FAFBFD] font-sans text-slate-800 min-h-screen flex items-center justify-center p-6 antialiased">

  <div class="w-full <%= portal === 'business' ? 'max-w-2xl' : 'max-w-md' %> bg-white rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 p-8 sm:p-10 space-y-6 transition-all duration-200">
    
    <!-- Logo & Title -->
    <div class="flex flex-col items-center text-center space-y-2">
      <div class="w-10 h-10 rounded-xl bg-[#4338CA] flex items-center justify-center text-white shadow-md shadow-indigo-600/20">
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M4 6h2v2H4zm0 5h2v2H4zm0 5h2v2H4zm5-10h11v2H9zm0 5h11v2H9zm0 5h11v2H9z" />
        </svg>
      </div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">
        <%= portal === 'business' ? 'Business Registration' : 'Create Account' %>
      </h1>
      <p class="text-sm text-slate-500">
        Registering for: <strong class="text-[#4338CA] uppercase"><%= portal %> Portal</strong>
      </p>
    </div>

    <!-- Portal Selection Tabs -->
    <div class="flex rounded-xl bg-slate-100 p-1 text-xs font-semibold text-slate-600">
      <a href="/signup?portal=consumer" class="flex-1 py-2 text-center rounded-lg <%= portal === 'consumer' ? 'bg-white text-slate-900 shadow-sm' : 'hover:text-slate-900' %>">Consumer</a>
      <a href="/signup?portal=business" class="flex-1 py-2 text-center rounded-lg <%= portal === 'business' ? 'bg-white text-slate-900 shadow-sm' : 'hover:text-slate-900' %>">Business</a>
      <a href="/signup?portal=legal" class="flex-1 py-2 text-center rounded-lg <%= portal === 'legal' ? 'bg-white text-slate-900 shadow-sm' : 'hover:text-slate-900' %>">Legal</a>
    </div>

    <!-- Consumer Google Sign Up Button -->
    <% if (portal === 'consumer') { %>
      <div class="space-y-4">
        <a 
          href="/auth/google/mock" 
          class="w-full py-2.5 px-4 border border-slate-200 hover:border-slate-300 rounded-xl flex items-center justify-center gap-3 text-sm font-semibold text-slate-700 bg-white hover:bg-slate-50 transition-colors"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          Continue with Google
        </a>

        <div class="flex items-center gap-3">
          <div class="h-px flex-1 bg-slate-200"></div>
          <span class="text-xs uppercase text-slate-400 font-semibold tracking-wider">or sign up with username</span>
          <div class="h-px flex-1 bg-slate-200"></div>
        </div>
      </div>
    <% } %>

    <!-- Error Alert -->
    <% if (error) { %>
      <div class="p-3 rounded-xl bg-red-50 border border-red-100 text-xs text-red-600 font-medium text-center">
        <%= error %>
      </div>
    <% } %>

    <!-- Form -->
    <form action="/signup" method="POST" class="space-y-4">
      <input type="hidden" name="portal" value="<%= portal %>" />

      <% if (portal === 'business') { %>
        <!-- Handwritten Notes Specific Fields -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          
          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Business / Store Name</label>
            <input 
              type="text" 
              name="businessName" 
              required 
              placeholder="e.g. SunJoy Foods Pvt. Ltd."
              class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-[#4338CA] focus:ring-2 focus:ring-indigo-100 transition-all placeholder:text-slate-400"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Business Type</label>
            <select 
              name="businessType" 
              required
              class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-[#4338CA] focus:ring-2 focus:ring-indigo-100 transition-all text-slate-700 bg-white"
            >
              <option value="" disabled selected>Select Business Type</option>
              <option value="Manufacturer">Manufacturer</option>
              <option value="Supermarket">Supermarket</option>
              <option value="Retail Store">Retail Store</option>
              <option value="Distributor">Distributor</option>
            </select>
          </div>

          <div class="sm:col-span-2">
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Store Address</label>
            <input 
              type="text" 
              name="storeAddress" 
              required 
              placeholder="Full physical street address, City, State, PIN"
              class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-[#4338CA] focus:ring-2 focus:ring-indigo-100 transition-all placeholder:text-slate-400"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Business Email</label>
            <input 
              type="email" 
              name="businessEmail" 
              required 
              placeholder="compliance@company.com"
              class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-[#4338CA] focus:ring-2 focus:ring-indigo-100 transition-all placeholder:text-slate-400"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Phone Number</label>
            <input 
              type="tel" 
              name="phoneNumber" 
              required 
              placeholder="+91 98765 43210"
              class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-[#4338CA] focus:ring-2 focus:ring-indigo-100 transition-all placeholder:text-slate-400"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
              GSTIN <span class="text-slate-400 font-normal text-[11px]">(Optional)</span>
            </label>
            <input 
              type="text" 
              name="gstin" 
              placeholder="06AAJCS1234A1ZX"
              class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-[#4338CA] focus:ring-2 focus:ring-indigo-100 transition-all placeholder:text-slate-400"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Authorized Person / Manager Name</label>
            <input 
              type="text" 
              name="managerName" 
              required 
              placeholder="Manager full name"
              class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-[#4338CA] focus:ring-2 focus:ring-indigo-100 transition-all placeholder:text-slate-400"
            />
          </div>

          <div class="sm:col-span-2 pt-2 border-t border-slate-100">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Account Credentials</span>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Username</label>
            <input 
              type="text" 
              name="username" 
              required 
              placeholder="Choose username"
              class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-[#4338CA] focus:ring-2 focus:ring-indigo-100 transition-all placeholder:text-slate-400"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Password</label>
            <input 
              type="password" 
              name="password" 
              required 
              placeholder="••••••••"
              class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-[#4338CA] focus:ring-2 focus:ring-indigo-100 transition-all placeholder:text-slate-400"
            />
          </div>

          <div class="sm:col-span-2">
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Confirm Password</label>
            <input 
              type="password" 
              name="confirmPassword" 
              required 
              placeholder="••••••••"
              class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-[#4338CA] focus:ring-2 focus:ring-indigo-100 transition-all placeholder:text-slate-400"
            />
          </div>

        </div>

      <% } else { %>
        <!-- Standard Consumer / Legal Registration -->
        <div>
          <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Username</label>
          <input 
            type="text" 
            name="username" 
            required 
            placeholder="Choose username"
            class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-[#4338CA] focus:ring-2 focus:ring-indigo-100 transition-all placeholder:text-slate-400"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Password</label>
          <input 
            type="password" 
            name="password" 
            required 
            placeholder="••••••••"
            class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-[#4338CA] focus:ring-2 focus:ring-indigo-100 transition-all placeholder:text-slate-400"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Confirm Password</label>
          <input 
            type="password" 
            name="confirmPassword" 
            required 
            placeholder="••••••••"
            class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-[#4338CA] focus:ring-2 focus:ring-indigo-100 transition-all placeholder:text-slate-400"
          />
        </div>
      <% } %>

      <button 
        type="submit" 
        class="w-full py-3 rounded-xl bg-[#4338CA] hover:bg-[#3730A3] text-white font-semibold text-sm shadow-md transition-all mt-2"
      >
        <%= portal === 'business' ? 'Register Business' : 'Register Account' %>
      </button>
    </form>

    <!-- Sign In Link -->
    <div class="text-center pt-2 border-t border-slate-100">
      <p class="text-xs text-slate-500">
        Already registered? 
        <a href="/signin?portal=<%= portal %>" class="font-semibold text-[#4338CA] hover:underline">Sign In</a>
      </p>
    </div>

  </div>
</body>
</html>