<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LabelIQ - Product Compliance Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] },
          colors: {
            brand: {
              DEFAULT: '#4638d9',
              hover: '#3a2ec2'
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-[#fcfdff] text-slate-700 antialiased font-sans min-h-screen flex flex-col">

  <!-- Top Navbar -->
  <header class="w-full bg-white border-b border-slate-100 sticky top-0 z-50">
    <div class="px-8 h-16 flex items-center justify-between">
      
      <!-- Brand & Links -->
      <div class="flex items-center gap-10">
        <a href="/" class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-lg bg-[#4638d9] flex items-center justify-center text-white">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <line x1="4" y1="6" x2="6" y2="6" />
              <line x1="10" y1="6" x2="20" y2="6" />
              <line x1="4" y1="12" x2="6" y2="12" />
              <line x1="10" y1="12" x2="20" y2="12" />
              <line x1="4" y1="18" x2="6" y2="18" />
              <line x1="10" y1="18" x2="20" y2="18" />
            </svg>
          </div>
          <span class="text-xl font-bold text-slate-900 tracking-tight">LabelIQ</span>
        </a>

        <nav class="hidden md:flex items-center gap-8 text-[15px] font-medium text-slate-600">
          <a href="#" class="hover:text-slate-900 transition-colors">Product</a>
          <a href="#" class="hover:text-slate-900 transition-colors">Rule Engine</a>
          <a href="/verification" class="hover:text-slate-900 transition-colors">Verification</a>
        </nav>
      </div>

      <!-- Right Profile Menu with Functional Dropdown -->
      <div class="flex items-center gap-6">
        <div class="relative" id="portal-menu-container">
          <button 
            id="portal-btn"
            type="button"
            class="flex items-center gap-1.5 text-[14px] font-medium text-slate-800 hover:text-slate-900 focus:outline-none"
          >
            <span>Business Portal</span>
            <svg id="dropdown-chevron" class="w-4 h-4 text-slate-400 stroke-[2] transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <div 
            id="portal-dropdown" 
            class="hidden absolute right-0 top-full mt-2 w-56 bg-white rounded-2xl shadow-xl shadow-slate-200/60 border border-slate-100 overflow-hidden z-50 py-1"
          >
            <a href="/" class="w-full px-5 py-3 text-left text-[14px] font-medium text-slate-800 hover:bg-slate-50 transition-colors block">
              Consumer Portal
            </a>
            <a href="/business" class="w-full px-5 py-3 text-left text-[14px] font-medium text-[#4638d9] bg-[#f5f6ff] hover:bg-[#eceeff] flex items-center justify-between transition-colors block">
              <span>Business Portal</span>
              <svg class="w-3.5 h-3.5 text-[#4638d9] stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
            <a href="/legal" class="w-full px-5 py-3 text-left text-[14px] font-medium text-slate-800 hover:bg-slate-50 transition-colors block">
              Legal Authority
            </a>
          </div>
        </div>

        <a href="/signin" class="px-5 py-2 rounded-lg bg-[#4638d9] hover:bg-[#3a2ec2] text-white font-medium text-[14px] shadow-sm transition-colors">
          Sign Out
        </a>
      </div>
    </div>
  </header>

  <div class="flex flex-1">
    
    <!-- Sidebar -->
    <aside class="w-64 border-r border-slate-100 bg-white flex flex-col justify-between py-6 px-4 shrink-0">
      <div class="space-y-6">
        
        <!-- Company Header -->
        <div class="flex items-center justify-between px-3 py-1">
          <div>
            <h2 class="text-sm font-bold text-slate-900 leading-tight"><%= data.company.name %></h2>
            <p class="text-xs text-slate-400 mt-0.5"><%= data.company.role %></p>
          </div>
          <button class="text-slate-400 hover:text-slate-600">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
        </div>

        <!-- Navigation Links -->
        <nav class="space-y-1">
          <!-- Active Tab: Overview -->
          <a href="#" class="flex items-center gap-3 px-3 py-2.5 rounded-xl bg-[#f5f6ff] text-[#4638d9] font-semibold text-[14px]">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <rect x="3" y="3" width="7" height="7" rx="1"></rect>
              <rect x="14" y="3" width="7" height="7" rx="1"></rect>
              <rect x="14" y="14" width="7" height="7" rx="1"></rect>
              <rect x="3" y="14" width="7" height="7" rx="1"></rect>
            </svg>
            Overview
          </a>

          <a 
            href="#" 
            onclick="openArtworkModal(); return false;" 
            class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-600 hover:bg-slate-50 font-medium text-[14px] transition-colors"
>
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>Artwork Pre-Check</span>
          </a>
          <a 
            href="#" 
            onclick="openScanModal('business'); return false;" 
            class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-600 hover:bg-slate-50 font-medium text-[14px] transition-colors"
            >
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
            </svg>
            <span>Scan Commodity</span>
          </a>


          <a 
            href="/business/corrections" 
            class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-600 hover:bg-slate-50 font-medium text-[14px] transition-colors"
            >
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Correction History</span>
          </a>
        </nav>
      </div>

      <!-- Verification Footer -->
      <div class="px-3 pt-6 border-t border-slate-100 text-xs text-slate-400 space-y-1">
        <p>GSTIN: <%= data.company.gstin %></p>
        <p class="flex items-center gap-1 text-slate-500 font-medium">
          Verified Manufacturer
          <span class="text-slate-600">✓</span>
        </p>
      </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 px-10 py-8 overflow-y-auto">
      
      <!-- Top Title + Action Button -->
      <div class="flex items-start justify-between">
        <div>
          <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Product Compliance</h1>
          <p class="text-sm text-slate-500 mt-1">Batch audit dashboard — <%= data.company.name %> Pvt. Ltd.</p>
        </div>
        <button 
            type="button" 
            onclick="openScanModal('business')" 
            class="px-5 py-2.5 rounded-xl bg-[#4b3ce5] hover:bg-[#3f30d4] text-white font-semibold text-sm flex items-center gap-2 shadow-md transition-all"
        >
            <svg class="w-4 h-4 text-emerald-400 stroke-[2.2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0a2 2 0 002-2v-4a2 2 0 00-2-2h-4a2 2 0 00-2 2v4a2 2 0 002 2h4zm-6 4h.01M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>Scan Label</span>
            
        </button>

        <button 
            type="button" 
            onclick="openArtworkModal()" 
            class="px-5 py-2.5 rounded-xl bg-[#4b3ce5] hover:bg-[#3f30d4] text-white font-semibold text-sm flex items-center gap-2 shadow-md transition-all"
>
            <svg class="w-4 h-4 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            <span>Artwork Pre-Check</span>
        </button>
      </div>

      <!-- 4 Stats Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mt-8">
        
        <div class="bg-white border border-slate-200/70 rounded-2xl p-6 shadow-xs">
          <p class="text-3xl font-bold text-slate-900"><%= data.metrics.scannedCount %></p>
          <p class="text-sm font-semibold text-slate-800 mt-2">Products scanned</p>
          <p class="text-xs text-slate-400 mt-0.5"><%= data.metrics.scannedPeriod %></p>
        </div>

        <div class="bg-white border border-slate-200/70 rounded-2xl p-6 shadow-xs">
          <p class="text-3xl font-bold text-[#059669]"><%= data.metrics.compliantRate %></p>
          <p class="text-sm font-semibold text-slate-800 mt-2">Compliant rate</p>
          <p class="text-xs text-slate-400 mt-0.5"><%= data.metrics.compliantSubtitle %></p>
        </div>

        <div class="bg-white border border-slate-200/70 rounded-2xl p-6 shadow-xs">
          <p class="text-3xl font-bold text-slate-900"><%= data.metrics.pendingReview %></p>
          <p class="text-sm font-semibold text-slate-800 mt-2">Pending review</p>
          <p class="text-xs text-slate-400 mt-0.5"><%= data.metrics.pendingSubtitle %></p>
        </div>

        <div class="bg-white border border-slate-200/70 rounded-2xl p-6 shadow-xs">
          <p class="text-3xl font-bold text-[#dc2626]"><%= data.metrics.violationsCount %></p>
          <p class="text-sm font-semibold text-slate-800 mt-2">Active violations</p>
          <p class="text-xs text-slate-400 mt-0.5"><%= data.metrics.violationsSubtitle %></p>
        </div>
      </div>

      <!-- Table Container -->
      <div class="mt-8 bg-white border border-slate-200/80 rounded-2xl overflow-hidden shadow-xs">
        
        <!-- Search & Export Bar -->
        <div class="p-5 flex flex-wrap items-center justify-between gap-4">
          <div class="relative w-full sm:w-96">
            <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input 
              type="text" 
              placeholder="Search products..." 
              class="w-full pl-10 pr-8 py-2 border border-slate-200 rounded-lg text-sm placeholder-slate-400 focus:outline-none focus:border-indigo-400"
            />
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-slate-400 font-mono">/</span>
          </div>

          <div class="flex items-center gap-4">
            <span class="text-xs text-slate-400 font-medium">7 products</span>
            <button class="px-4 py-2 border border-slate-200 rounded-lg text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors shadow-xs">
              Export CSV
            </button>
          </div>
        </div>

        <!-- Products Table -->
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="border-y border-slate-100 bg-[#f9fafb]/50 text-slate-400 font-bold uppercase tracking-wider">
                <th class="py-3 px-6">PRODUCT</th>
                <th class="py-3 px-6">SKU</th>
                <th class="py-3 px-6">TYPE</th>
                <th class="py-3 px-6">DESTINATION</th>
                <th class="py-3 px-6">LAST CHECKED</th>
                <th class="py-3 px-6">STATUS</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% data.products.forEach(item => { %>
                <tr class="hover:bg-slate-50/70 transition-colors">
                  <td class="py-4 px-6">
                    <p class="font-bold text-slate-800 text-[13px]"><%= item.name %></p>
                    <p class="text-slate-400 mt-0.5"><%= item.category %></p>
                  </td>

                  <td class="py-4 px-6 font-mono text-slate-500 text-[11px]"><%= item.sku %></td>

                  <td class="py-4 px-6">
                    <% if (item.type === 'Retail') { %>
                      <span class="px-2.5 py-0.5 rounded-full bg-[#eef2ff] text-[#4338ca] text-[11px] font-medium">Retail</span>
                    <% } else { %>
                      <span class="px-2.5 py-0.5 rounded-full bg-[#ecfdf5] text-[#059669] text-[11px] font-medium">Bulk</span>
                    <% } %>
                  </td>

                  <td class="py-4 px-6 text-slate-500 text-[12px]"><%= item.destination %></td>

                  <td class="py-4 px-6 text-slate-500 text-[12px]"><%= item.lastChecked %></td>

                  <td class="py-4 px-6">
                    <div class="flex items-center gap-2">
                      <% if (item.status === 'Compliant') { %>
                        <span class="px-3 py-1 rounded-full bg-[#ecfdf5] text-[#059669] text-[11px] font-semibold">Compliant</span>
                      <% } else if (item.status === 'Non-Compliant') { %>
                        <span class="px-3 py-1 rounded-full bg-[#fef2f2] text-[#dc2626] text-[11px] font-semibold">Non-Compliant</span>
                        <% if (item.flagCount) { %>
                          <span class="text-[11px] font-semibold text-[#dc2626]"><%= item.flagCount %></span>
                        <% } %>
                      <% } else if (item.status === 'Needs Review') { %>
                        <span class="px-3 py-1 rounded-full bg-[#fffbeb] text-[#d97706] text-[11px] font-semibold">Needs Review</span>
                        <% if (item.flagCount) { %>
                          <span class="text-[11px] font-semibold text-[#d97706]"><%= item.flagCount %></span>
                        <% } %>
                      <% } else { %>
                        <span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-[11px] font-semibold">Pending</span>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <div class="p-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
          <span>Page 1 of 1</span>
          <div class="flex items-center gap-2">
            <button class="px-2.5 py-1 text-slate-400 hover:text-slate-600">&lt; Prev</button>
            <button class="w-6 h-6 rounded bg-[#4638d9] text-white font-semibold flex items-center justify-center">1</button>
            <button class="px-2.5 py-1 text-slate-400 hover:text-slate-600">Next &gt;</button>
          </div>
        </div>

      </div>

    </main>
  </div>

  <!-- Help Floating Action Button -->
  <button 
    aria-label="Help" 
    class="fixed bottom-6 right-6 w-10 h-10 rounded-full bg-[#181d27] text-white flex items-center justify-center font-bold text-sm shadow-md hover:bg-black transition-colors"
  >
    ?
  </button>

  <script>
    const portalBtn = document.getElementById('portal-btn');
    const portalDropdown = document.getElementById('portal-dropdown');
    const dropdownChevron = document.getElementById('dropdown-chevron');

    portalBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      portalDropdown.classList.toggle('hidden');
      dropdownChevron.classList.toggle('rotate-180');
    });

    document.addEventListener('click', (e) => {
      const container = document.getElementById('portal-menu-container');
      if (container && !container.contains(e.target)) {
        portalDropdown.classList.add('hidden');
        dropdownChevron.classList.remove('rotate-180');
      }
    });
  </script>
  <%- include('artwork_check') %>
  <%- include('scan_modal') %>
</body>
</html>