<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verification Guidelines - LabelIQ</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#0f172a] text-slate-100 min-h-screen flex flex-col font-sans antialiased p-6">
  <div class="max-w-4xl w-full mx-auto space-y-4">
    <div class="flex items-center justify-between border-b border-slate-800 pb-4">
      <h1 class="text-lg font-bold text-white">Verification Setup</h1>
      <button onclick="window.history.back()" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-200">
        ← Back
      </button>
    </div>
    <div class="bg-[#1e293b] border border-slate-800 rounded-2xl p-6 shadow-xl">
      <pre class="font-mono text-sm leading-relaxed text-emerald-400 whitespace-pre-wrap"><%= content %></pre>
    </div>
  </div>
</body>
</html>