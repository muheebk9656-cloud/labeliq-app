<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In - LabelIQ</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: { extend: { fontFamily: { sans: ['Inter', 'sans-serif'] } } }
    }
  </script>
</head>
<body class="bg-[#FAFBFD] font-sans text-slate-800 min-h-screen flex items-center justify-center p-6 antialiased">

  <div class="w-full max-w-md bg-white rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 p-8 sm:p-10 space-y-6">
    
    <div class="flex flex-col items-center text-center space-y-2">
      <div class="w-10 h-10 rounded-xl bg-[#4338CA] flex items-center justify-center text-white shadow-md shadow-indigo-600/20">
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M4 6h2v2H4zm0 5h2v2H4zm0 5h2v2H4zm5-10h11v2H9zm0 5h11v2H9zm0 5h11v2H9z" />
        </svg>
      </div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Sign In</h1>
      <p class="text-sm text-slate-500">
        Portal: <strong class="text-[#4338CA] uppercase"><%= portal %></strong>
      </p>
    </div>

    <!-- Portal Switcher -->
    <div class="flex rounded-xl bg-slate-100 p-1 text-xs font-semibold text-slate-600">
      <a href="/signin?portal=consumer" class="flex-1 py-2 text-center rounded-lg <%= portal === 'consumer' ? 'bg-white text-slate-900 shadow-sm' : 'hover:text-slate-900' %>">Consumer</a>
      <a href="/signin?portal=business" class="flex-1 py-2 text-center rounded-lg <%= portal === 'business' ? 'bg-white text-slate-900 shadow-sm' : 'hover:text-slate-900' %>">Business</a>
      <a href="/signin?portal=legal" class="flex-1 py-2 text-center rounded-lg <%= portal === 'legal' ? 'bg-white text-slate-900 shadow-sm' : 'hover:text-slate-900' %>">Legal</a>
    </div>

    <!-- Credential Hint Box -->
    <div class="p-3.5 rounded-xl bg-indigo-50/60 border border-indigo-100 text-xs text-indigo-950 flex items-center justify-between">
      <div>
        <% if (portal === 'consumer') { %>
          <p><span class="font-semibold text-[#4338CA]">User:</span> admin</p>
          <p><span class="font-semibold text-[#4338CA]">Pass:</span> admin123</p>
        <% } else if (portal === 'business') { %>
          <p><span class="font-semibold text-[#4338CA]">User:</span> business_user</p>
          <p><span class="font-semibold text-[#4338CA]">Pass:</span> admin123</p>
        <% } else { %>
          <p><span class="font-semibold text-[#4338CA]">Officer:</span> inspector</p>
          <p><span class="font-semibold text-[#4338CA]">Pass:</span> admin123</p>
        <% } %>
      </div>
      <button 
        type="button" 
        id="autofill-btn"
        data-portal="<%= portal %>"
        class="text-xs font-semibold text-[#4338CA] bg-white px-2.5 py-1.5 rounded-lg border border-indigo-200 hover:bg-indigo-50 transition-colors shadow-xs"
      >
        Auto Fill
      </button>
    </div>

    <!-- Consumer Google Login Option -->
    <% if (portal === 'consumer') { %>
      <div class="space-y-4">
        <a 
          href="/auth/google/mock" 
          class="w-full py-2.5 px-4 border border-slate-200 hover:border-slate-300 rounded-xl flex items-center justify-center gap-3 text-sm font-semibold text-slate-700 bg-white hover:bg-slate-50 transition-colors"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          Continue with Google
        </a>

        <div class="flex items-center gap-3">
          <div class="h-px flex-1 bg-slate-200"></div>
          <span class="text-xs uppercase text-slate-400 font-semibold tracking-wider">or sign in with credentials</span>
          <div class="h-px flex-1 bg-slate-200"></div>
        </div>
      </div>
    <% } %>

    <% if (error) { %>
      <div class="p-3 rounded-xl bg-red-50 border border-red-100 text-xs text-red-600 font-medium text-center">
        <%= error %>
      </div>
    <% } %>

    <!-- Form -->
    <form action="/signin" method="POST" class="space-y-4">
      <input type="hidden" name="targetPortal" value="<%= portal %>" />

      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Username</label>
        <input 
          type="text" 
          id="username" 
          name="username" 
          required 
          class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-[#4338CA] focus:ring-2 focus:ring-indigo-100 transition-all placeholder:text-slate-400"
        />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Password</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          required 
          class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-[#4338CA] focus:ring-2 focus:ring-indigo-100 transition-all placeholder:text-slate-400"
        />
      </div>

      <button 
        type="submit" 
        class="w-full py-3 rounded-xl bg-[#4338CA] hover:bg-[#3730A3] text-white font-semibold text-sm shadow-md transition-all mt-2"
      >
        Sign In
      </button>
    </form>

    <!-- Administrative Window Link for Legal Portal -->
    <% if (portal === 'legal') { %>
      <div class="pt-3 border-t border-slate-100 flex flex-col items-center">
        <a 
          href="/legal/admin/auth" 
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 text-xs font-semibold hover:bg-amber-100 transition-colors"
        >
          <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          Admin Login (Register Officers)
        </a>
      </div>
    <% } %>

    <div class="text-center pt-2 border-t border-slate-100">
      <p class="text-xs text-slate-500">
        Don't have an account for this portal? 
        <a href="/signup?portal=<%= portal %>" class="font-semibold text-[#4338CA] hover:underline">Sign Up</a>
      </p>
    </div>

  </div>

  <script>
    const autofillBtn = document.getElementById('autofill-btn');
    if (autofillBtn) {
      autofillBtn.addEventListener('click', () => {
        const portal = autofillBtn.dataset.portal;
        const u = document.getElementById('username');
        const p = document.getElementById('password');

        if (portal === 'consumer') {
          u.value = 'admin';
          p.value = 'admin123';
        } else if (portal === 'business') {
          u.value = 'business_user';
          p.value = 'admin123';
        } else if (portal === 'legal') {
          u.value = 'inspector';
          p.value = 'admin123';
        }
      });
    }
  </script>
</body>
</html>